# Optional: DreiTrack automatically creates a per-installation random signing
# secret when this variable is not supplied. For centrally managed deployments,
# set your own long random value instead.
DREITRACK_SESSION_SECRET=change-me-to-a-long-random-secret

# Local Ollama settings on the DreiTrack server.
DREITRACK_OLLAMA_URL=http://127.0.0.1:11434
DREITRACK_AI_MODEL=dreitrack-ai:1.0
DREITRACK_AI_TIMEOUT_SECONDS=90

# Keep 0 for the v0.4 plain-HTTP private LAN build.
# Set to 1 only when actually served through HTTPS.
DREITRACK_HTTPS_ONLY=0
